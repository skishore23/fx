{
  "name": "@fx/framework",
  "version": "1.0.0",
  "description": "Functional programming framework with category theory principles for building AI agents",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "clean": "npm run clean --workspaces && rm -rf dist",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "test:experiments": "npm run build && node --test examples/discovery/experiments.test.cjs examples/algorithm-search/algorithm-search.test.cjs",
    "experiment:transfer": "npm run build --silent && node examples/discovery/transfer.cjs",
    "experiment:scheduling": "npm run build --silent && node examples/discovery/scheduling-discovery.cjs",
    "algorithm:search": "npm run build --silent && node examples/algorithm-search/run.cjs",
    "research:verify": "npm run build --silent && python3 -m research.exact_join.verify_manifest && python3 -m unittest research.exact_join.test_exact -v && node research/exact_join/verify-fx.cjs && node research/exact_join/verify-fx.cjs --scaling && node research/exact_join/recovery.cjs"
  },
  "keywords": [
    "functional-programming",
    "category-theory",
    "typescript",
    "ai-agents",
    "framework",
    "immutable",
    "composable"
  ],
  "author": "Fx Framework Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fx-framework/fx.git"
  },
  "bugs": {
    "url": "https://github.com/fx-framework/fx/issues"
  },
  "homepage": "https://github.com/fx-framework/fx#readme",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^4.3.1"
  }
}
